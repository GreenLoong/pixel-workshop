<RCC>
 <qresource prefix="/indicators">
  <file alias="radio.svg">icons/radio.svg</file>
  <file alias="radio-disabled.svg">icons/radio-disabled.svg</file>
  <file alias="check.svg">icons/check.svg</file>
  <file alias="check-disabled.svg">icons/check-disabled.svg</file>
  <file alias="chevron-down.svg">icons/chevron-down.svg</file>
  <file alias="fullscreen.svg">icons/fullscreen.svg</file>
  <file alias="minimize.svg">icons/minimize.svg</file>
  <file alias="maximize.svg">icons/maximize.svg</file>
  <file alias="restore-window.svg">icons/restore-window.svg</file>
  <file alias="close.svg">icons/close.svg</file>
 </qresource>
 <qresource prefix="/styles">
  <file alias="dialog.qss">styles/dialog.qss</file>
 </qresource>
</RCC>
